---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
interface Props { title: string; current: string; icon: string; intro?: string }
const { title, current, icon, intro } = Astro.props;
---
<Base title={title} current={current}>
  <section class="world">
    <header class="page-head">
      <h1><Icon name={icon} size={34} /> {title}</h1>
      <div class="orn-rule" aria-hidden="true"><span>❖</span></div>
      {intro && <p class="page-intro">{intro}</p>}
    </header>
    <slot />
  </section>
</Base>
