---
import WorldPage from '../../../components/WorldPage.astro';
import Entity from '../../../components/Entity.astro';
import { loadAll } from '../../../lib/data';
const { npc } = await loadAll();
---
<WorldPage title="NPC" current="npc" icon="user" intro="Postacie spotkane przez drużynę w trakcie wędrówki.">
  {npc.length ? <div class="cards">{npc.map((n) => <Entity kind="npc" entry={n} />)}</div> : <p class="empty">Brak wpisów.</p>}
</WorldPage>
