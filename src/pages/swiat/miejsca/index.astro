---
import WorldPage from '../../../components/WorldPage.astro';
import Entity from '../../../components/Entity.astro';
import { loadAll } from '../../../lib/data';
const { miejsca } = await loadAll();
---
<WorldPage title="Miejsca" current="miejsca" icon="pin">
  {miejsca.length ? <div class="cards cards-wide">{miejsca.map((m) => <Entity kind="miejsce" entry={m} />)}</div> : <p class="empty">Brak wpisów.</p>}
</WorldPage>
